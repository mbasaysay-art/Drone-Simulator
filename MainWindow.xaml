<Window x:Class="DroneSimulator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Drone Simulator | Prototype" Height="670" Width="1050" Background="#0D1625" Foreground="#E8F1FA"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="DRONE SIMULATOR" FontSize="28" FontWeight="Bold"/><TextBlock Text="Standalone virtual fleet and local validation prototype — no real aircraft connection" Foreground="#9AAFC5" Margin="0,4,0,20"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Aircraft library" FontSize="18" Margin="0,0,0,12"/><ListBox x:Name="AircraftList" Height="360" Background="#17273B" Foreground="White" BorderThickness="0" SelectionChanged="AircraftChanged"/><Button Content="Start virtual flight" Click="StartClicked" Margin="0,14,0,5" Height="38"/><Button Content="Inject GNSS loss" Click="FaultClicked" Height="38"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Telemetry monitor" FontSize="18" Margin="0,0,0,12"/><Border Background="#17273B" CornerRadius="12" Padding="24"><StackPanel><TextBlock x:Name="ModelText" Text="Select an aircraft" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Status: idle" Margin="0,14,0,0"/><TextBlock x:Name="AltitudeText" Text="Altitude: 0 m" Margin="0,12,0,0"/><TextBlock x:Name="BatteryText" Text="Battery: 100%" Margin="0,12,0,0"/><TextBlock x:Name="GnssText" Text="GNSS: normal" Margin="0,12,0,0"/><TextBlock x:Name="PositionText" Text="Position: simulated origin" Margin="0,12,0,0"/><TextBlock Text="Simulation only. No DJI protocol emulation or hardware validation is included in this starter." Foreground="#9AAFC5" TextWrapping="Wrap" Margin="0,32,0,0"/></StackPanel></Border></StackPanel></Grid><TextBlock Grid.Row="2" Foreground="#9AAFC5" Text="Prototype v0.1 • Local-only • No aircraft commands • Build with .NET 8 SDK" Margin="0,18,0,0"/></Grid></Window>
