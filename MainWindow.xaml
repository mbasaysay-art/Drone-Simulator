<Window x:Class="DroneSimulator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Drone Simulator | Simulation Connector" Height="800" Width="1100" Background="#0D1625" Foreground="#E8F1FA">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="DRONE SIMULATOR" FontSize="28" FontWeight="Bold"/><TextBlock Text="SIMULATION ONLY · Test telemetry for Mission Operations" Foreground="#9AAFC5" Margin="0,4,0,16"/></StackPanel>
  <Border Grid.Row="1" Background="#17273B" CornerRadius="10" Padding="18" Margin="0,0,0,20"><StackPanel>
   <TextBlock Text="Connect to your test system" FontSize="18" Margin="0,0,0,10"/>
   <TextBlock Text="System address"/><TextBox x:Name="ServerAddress" Text="http://localhost:3000" Foreground="Black" Margin="0,4,0,8" Padding="6"/>
   <TextBlock Text="One-time connection code"/><TextBox x:Name="PairingCode" Foreground="Black" MaxLength="32" Margin="0,4,0,8" Padding="6"/>
   <TextBlock Text="In your system: Mission Operations → Live Monitoring → Simulation → Pair Windows simulator. Keep that browser signed in." TextWrapping="Wrap" Foreground="#9AAFC5"/>
   <WrapPanel Margin="0,10,0,0"><Button x:Name="ConnectButton" Content="Connect" Click="ConnectClicked" Padding="20,7"/><Button x:Name="DisconnectButton" Content="Disconnect &amp; clear aircraft" Click="DisconnectClicked" Padding="20,7" Margin="10,0,0,0" IsEnabled="False"/></WrapPanel>
   <TextBlock x:Name="ConnectionStatus" Text="Not connected" TextWrapping="Wrap" Margin="0,10,0,0"/>
  </StackPanel></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,16,0"><TextBlock Text="Aircraft library" FontSize="18" Margin="0,0,0,12"/>
    <ListBox x:Name="AircraftList" Height="180" Background="#17273B" Foreground="White" BorderThickness="0" SelectionChanged="AircraftChanged"/>
    <TextBlock Text="Test origin · latitude / longitude" Margin="0,12,0,4"/>
    <WrapPanel><TextBox x:Name="LatitudeInput" Text="25.28000" Foreground="Black" Width="120" Padding="5"/><TextBox x:Name="LongitudeInput" Text="51.53000" Foreground="Black" Width="120" Margin="8,0,0,0" Padding="5"/></WrapPanel>
    <Button Content="Start virtual flight" Click="StartClicked" Margin="0,12,0,5" Height="36"/><Button Content="Stop virtual flight" Click="StopClicked" Height="36" Margin="0,0,0,5"/><Button Content="Inject / restore GNSS loss" Click="FaultClicked" Height="36"/>
   </StackPanel>
   <Border Grid.Column="1" Background="#17273B" CornerRadius="12" Padding="24"><StackPanel>
    <TextBlock x:Name="ModelText" Text="Select an aircraft" FontSize="22" FontWeight="Bold"/>
    <TextBlock x:Name="StatusText" Text="Status: idle" Margin="0,14,0,0"/><TextBlock x:Name="AltitudeText" Text="Altitude: 0 m" Margin="0,12,0,0"/><TextBlock x:Name="BatteryText" Text="Battery: 100%" Margin="0,12,0,0"/><TextBlock x:Name="GnssText" Text="GNSS: normal" Margin="0,12,0,0"/><TextBlock x:Name="PositionText" Text="Position: simulated origin" Margin="0,12,0,0"/>
    <TextBlock Text="Test data appears only in your Simulation view. No commands are sent to aircraft. No DJI protocol emulation is included." Foreground="#9AAFC5" TextWrapping="Wrap" Margin="0,24,0,0"/>
   </StackPanel></Border>
  </Grid>
 </Grid></ScrollViewer>
</Window>
